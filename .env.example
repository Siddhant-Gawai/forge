# PostgreSQL connection. When set, PostgreSQL is the active application store.
# Copy the exact URI from Supabase Dashboard -> Connect -> Session pooler.
# Replace the password placeholder with your URL-encoded database password.
# Add sslmode=verify-full to validate the server certificate.
# On first start, migrations create the private forge schema and import FORGE_DATA.
# The original JSON file is preserved. Existing database records are never re-seeded.
DATABASE_URL=

FORGE_ADDR=127.0.0.1:8080
FORGE_BASE_URL=http://127.0.0.1:8080
FORGE_DATA=data/state.json
FORGE_DEMO=0
# Optional additional trusted root CA, if not using the standard Supabase certificate.
DATABASE_SSL_ROOT_CERT=

# Optional project metadata. Go account login does not use the Supabase Auth API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# A Supabase secret API key is not needed for the direct PostgreSQL integration.
# Never put database passwords or secret API keys in web/.
